{
  "name": "crohnsapp",
  "version": "1.0.0",
  "description": "A comprehensive health tracking application for individuals with Crohn's disease. This app enables users to track symptoms, diet, bowel movements, medications/supplements, and receive AI-powered insights to help manage their condition more effectively.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:chat": "npx playwright test chat.spec.ts",
    "test:insights": "npx playwright test insights.spec.ts",
    "test:supplements": "npx playwright test supplements.spec.ts",
    "test:notifications": "npx playwright test notification-preferences.spec.ts",
    "test:navigation": "npx playwright test navigation.spec.ts",
    "test:accessibility": "npx playwright test accessibility.spec.ts",
    "test:responsive": "npx playwright test responsive.spec.ts",
    "test:visual": "npx playwright test visual.spec.ts",
    "test:visual:update": "npx playwright test visual.spec.ts --update-snapshots",
    "test:report": "npx playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "serve": "^14.2.6"
  }
}
