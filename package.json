{
  "name": "crohnsapp",
  "version": "1.0.0",
  "description": "GutMD: Flutter app for Crohn's, colitis and IBS tracking with Gemini-powered insights (Firebase).",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "build:web": "flutter build web --release --dart-define-from-file=config/prod.json",
    "build:web:test": "flutter build web --release --dart-define-from-file=config/test.json -o build/web-test",
    "test:unit": "flutter test",
    "test:flutter": "npx playwright test -c playwright.flutter.config.ts",
    "test:flutter:video": "cross-env VIDEO=1 PW_WORKERS=4 npx playwright test -c playwright.flutter.config.ts",
    "test:report": "npx playwright show-report playwright-report/flutter",
    "test:mockups": "npx playwright test",
    "deploy:rules": "npx -y firebase-tools@14 deploy --only firestore:rules --project gutmd-app",
    "deploy:preview": "npx -y firebase-tools@14 hosting:channel:deploy preview --expires 30d --project gutmd-app"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "cross-env": "^10.1.0",
    "serve": "^14.2.6"
  }
}
